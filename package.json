{
  "name": "seeit",
  "version": "1.0.2",
  "description": "app used to view images and videos",
  "main": "index.js",
  "build": {
    "appId": "seeit",
    "mac": {
      "category": "utility",
      "icon": "icon.icns"
    },
    "win": {
      "icon": "./build/icon.ico"
    }
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafn/seeit.git"
  },
  "keywords": [
    "image",
    "gif",
    "WebM"
  ],
  "author": "Daniel Nilsen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dafn/seeit/issues"
  },
  "homepage": "https://github.com/dafn/seeit#readme",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
